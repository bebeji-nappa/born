{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development",
    "deploy": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "d1:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "d1:migrate:test": "wrangler d1 migrations apply DB --env test --remote",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "d1:query:local": "wrangler d1 execute DB --env development --local --command",
    "lint": "biome check ./src",
    "fix:lint": "biome check --write ./src",
    "format": "biome format ./src",
    "fix:format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint-staged": "pnpm lint-staged"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "mimetext": "^3.0.28",
    "resend": "^6.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vitest-pool-workers": "^0.12.12",
    "@cloudflare/workers-types": "^4.20260217.0",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.10",
    "lint-staged": "^17.0.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.0"
  }
}
