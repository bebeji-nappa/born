{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development",
    "deploy": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "d1:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "d1:query:local": "wrangler d1 execute DB --env development --local --command",
    "lint": "biome check ./src",
    "fix:lint": "biome check --write ./src",
    "format": "biome format ./src",
    "fix:format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint-staged": "pnpm lint-staged"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.3",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.9",
    "mimetext": "^3.0.27",
    "resend": "^6.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.11.17",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.30.6",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  }
}
