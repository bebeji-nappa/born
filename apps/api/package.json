{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development",
    "deploy": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "d1:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.3",
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^20.11.17",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.8.3",
    "wrangler": "^4.40.2"
  }
}
