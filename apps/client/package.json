    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vercel/og": "^1.0.1",
    "ahooks": "^3.9.7",
    "dayjs": "^1.11.23",
    "next": "16.3.1",
    "node-emoji": "^2.2.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.12",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@storybook/nextjs": "^10.5.9",
