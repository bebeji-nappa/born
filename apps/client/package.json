    "@richmd/react": "^3.0.4",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vercel/og": "^0.8.6",
    "ahooks": "^3.9.7",
    "dayjs": "^1.11.21",
    "next": "16.1.6",
    "node-emoji": "^2.2.0",
    "react": "^19.2.7",
    "react-aria": "^3.50.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.61.1",
    "@storybook/nextjs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
