{
  "name": "client",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check ./src",
    "fix:lint": "biome check --write ./src",
    "format": "biome format ./src",
    "fix:format": "biome format --write ./src",
    "test:component": "jest src/tests/components/** --config jest.config.ts",
    "test:api": "jest src/tests/api/** --config jest.config.ts",
    "test": "jest --config jest.config.ts",
    "e2e": "pnpm playwright test",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:watch": "test-storybook --watch",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint-staged": "pnpm lint-staged"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
