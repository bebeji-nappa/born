{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "clean": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "start": {
      "cache": false,
      "dependsOn": [
        "^start"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    },
    "fix:lint": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "fix:format": {
      "cache": false
    },
    "lint-staged": {
      "cache": false
    }
  }
}
